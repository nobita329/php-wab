<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0c16"/>
      <stop offset="50%" stop-color="#121829"/>
      <stop offset="100%" stop-color="#07080d"/>
    </linearGradient>
    <linearGradient id="glow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00f0ff"/>
      <stop offset="100%" stop-color="#7928ca"/>
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bg)"/>
  <circle cx="400" cy="250" r="140" fill="none" stroke="url(#glow)" stroke-width="2" stroke-dasharray="8 4" opacity="0.6"/>
  <polygon points="400,150 480,290 320,290" fill="none" stroke="#00f0ff" stroke-width="3"/>
  <circle cx="400" cy="250" r="12" fill="#00f0ff"/>
  <text x="400" y="370" font-family="'Outfit', sans-serif" font-size="24" font-weight="bold" fill="#ffffff" text-anchor="middle">NEXUS CYBERVERSE</text>
  <text x="400" y="405" font-family="'JetBrains Mono', monospace" font-size="14" fill="#00f0ff" text-anchor="middle">REAL-TIME 3D WEBGL ENGINE</text>
</svg>

