# ==========================================
# 3D PORTFOLIO & CMS ENVIRONMENT CONFIG
# ==========================================

# Application Settings
APP_NAME="Alex Vance | 3D Portfolio & Creative Technologist"
APP_ENV=production
APP_DEBUG=false
APP_URL="http://localhost:8000"
APP_TIMEZONE="UTC"

# Database Configuration (cPanel / Production MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio_db
DB_USERNAME=cpanel_user
DB_PASSWORD=cpanel_secure_password

# For local development with zero dependencies, set:
# DB_CONNECTION=sqlite
# DB_DATABASE=/path/to/storage/database.sqlite

# Security & Session Settings
SESSION_LIFETIME=7200
SESSION_SECURE=false
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Upload Limits (in bytes, 10485760 = 10MB)
MAX_FILE_SIZE=10485760

# Mail / SMTP Settings (Optional)
MAIL_ENABLED=false
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Portfolio Contact Form"

